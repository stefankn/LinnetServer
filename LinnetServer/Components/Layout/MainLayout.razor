@inherits LayoutComponentBase
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ChannelGroupsState GroupsState
@inject NavigationManager Nav
@implements IDisposable

<div class="min-h-screen flex bg-base-200">

    <!-- Sidebar -->
    <aside class="w-64 bg-base-100 flex flex-col shadow-lg shrink-0">
        <!-- Logo -->
        <div class="px-6 py-5 flex items-center gap-3 border-b border-base-300">
            <div class="bg-primary rounded-lg p-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-content" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.882v6.236a1 1 0 01-1.447.894L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z" />
                </svg>
            </div>
            <span class="text-xl font-bold tracking-tight">Linnet</span>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-4 overflow-y-auto">
            <ul class="menu menu-md gap-1">
                <li class="menu-title text-xs uppercase tracking-widest opacity-50 px-3">General</li>
                <li>
                    <a href="/" class="gap-3 @ActiveClass("/", exact: true)">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a href="/favorites" class="gap-3 @ActiveClass("/favorites", exact: true)">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                        </svg>
                        Favorites
                    </a>
                </li>
                <li>
                    <a href="/groups" class="gap-3 @ActiveClass("/groups", exact: true)">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        Manage Groups
                    </a>
                </li>
                <li class="mt-3">
                    <div class="px-3 py-1">
                        <span class="text-xs uppercase tracking-widest opacity-50">Channel Groups</span>
                    </div>
                </li>
                @if (_groups.Count == 0)
                {
                    <li class="px-3 py-1 text-xs opacity-40 italic">No groups yet</li>
                }
                else
                {
                    @foreach (var group in _groups)
                    {
                        <li>
                            <a href="/groups/@group.Id" class="gap-3 @ActiveClass($"/groups/{group.Id}")">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                                <span class="truncate">@group.Name</span>
                            </a>
                        </li>
                    }
                }
            </ul>
        </nav>

        <!-- Footer -->
        <div class="px-4 py-3 border-t border-base-300 text-xs opacity-40 text-center">
            Linnet IPTV Manager
        </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-w-0">
        <!-- Top bar -->
        <header class="bg-base-100 border-b border-base-300 px-8 py-4 flex items-center justify-end gap-4 shrink-0">
            <a href="/scalar/v1" target="_blank" class="btn btn-ghost btn-xs gap-1.5 opacity-60 hover:opacity-100">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
                API Docs
            </a>
            <div class="badge badge-primary badge-outline">Live</div>
        </header>

        <!-- Page content -->
        <main class="flex-1 p-8 overflow-y-auto">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 alert alert-error shadow-lg w-auto hidden">
    An unhandled error has occurred.
    <a href="." class="btn btn-sm btn-ghost">Reload</a>
    <span class="dismiss cursor-pointer btn btn-sm btn-ghost btn-circle">✕</span>
</div>

@code {
    private List<ChannelGroup> _groups = [];

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        GroupsState.OnChanged += OnGroupsChanged;
        await LoadGroups();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private async void OnGroupsChanged()
    {
        await LoadGroups();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadGroups()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _groups = await db.ChannelGroups.OrderBy(g => g.Name).ToListAsync();
    }

    private string ActiveClass(string href, bool exact = false)
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        var isActive = exact ? path == href : path == href || path.StartsWith(href + "/");
        return isActive ? "menu-active" : "";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        GroupsState.OnChanged -= OnGroupsChanged;
    }
}
